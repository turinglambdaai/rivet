<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Standalone acceptance smoke for the Windows device gateway.

       msbuild rivet-device-smoke.vcxproj /p:RIVET_ROOT=<repo root>
       produces RivetDeviceSmoke.exe: it creates the identity, starts the
       listener and the DNS-SD advertisement, and serves preface sessions
       through the portable host with empty boundaries (reconnects take the
       unknown-device path; pairing answers pairing_unavailable). -->
  <PropertyGroup Label="NuGet">
    <RestoreProjectStyle>PackageReference</RestoreProjectStyle>
    <NuGetTargetMoniker>native,Version=v0.0</NuGetTargetMoniker>
    <NuGetTargetPlatformIdentifier>Windows</NuGetTargetPlatformIdentifier>
    <NuGetTargetPlatformVersion>$(WindowsTargetPlatformVersion)</NuGetTargetPlatformVersion>
    <MSBuildProjectExtensionsPath>$(MSBuildThisFileDirectory)obj\rivet-device-smoke\</MSBuildProjectExtensionsPath>
  </PropertyGroup>
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|ARM64">
      <Configuration>Debug</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|ARM64">
      <Configuration>Release</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>17.0</VCProjectVersion>
    <ProjectGuid>{8F4C2A61-9D3B-4E27-B5A8-1C6E0F9D4B72}</ProjectGuid>
    <Keyword>Win32Proj</Keyword>
    <RootNamespace>rivet</RootNamespace>
    <ProjectName>rivet-device-smoke</ProjectName>
    <WindowsTargetPlatformVersion Condition="'$(WindowsTargetPlatformVersion)' == ''">10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <PlatformToolset>v145</PlatformToolset>
    <PlatformToolset Condition="'$(VisualStudioVersion)' == '17.0'">v143</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
    <UseDebugLibraries Condition="'$(Configuration)'=='Debug'">true</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(Configuration)'=='Release'">false</UseDebugLibraries>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <ConformanceMode>true</ConformanceMode>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <WarningLevel>Level4</WarningLevel>
      <AdditionalIncludeDirectories>$(RIVET_ROOT)\runtime\include;$(RIVET_ROOT)\platform\windows\device;$(RIVET_ROOT)\platform\windows\runtime;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>WIN32;_WINDOWS;NOMINMAX;UNICODE;_UNICODE;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
      <AdditionalDependencies>secur32.lib;ws2_32.lib;crypt32.lib;ncrypt.lib;bcrypt.lib;user32.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CppWinRT" Version="3.0.260818.1" Condition="'$(RivetCppWinRTVersion)' == ''" />
    <PackageReference Include="Microsoft.Windows.CppWinRT" Version="$(RivetCppWinRTVersion)" Condition="'$(RivetCppWinRTVersion)' != ''" />
  </ItemGroup>
  <ItemGroup>
    <ClCompile Include="$(RIVET_ROOT)\platform\windows\device\device_identity.cpp" />
    <ClCompile Include="$(RIVET_ROOT)\platform\windows\device\device_listener.cpp" />
    <ClCompile Include="$(RIVET_ROOT)\platform\windows\device\device_session_service.cpp" />
    <ClCompile Include="$(RIVET_ROOT)\platform\windows\device\device_smoke_main.cpp" />
    <ClCompile Include="$(RIVET_ROOT)\platform\windows\device\schannel_transport.cpp" />
    <ClCompile Include="$(RIVET_ROOT)\runtime\src\device_session.cpp" />
    <ClCompile Include="$(RIVET_ROOT)\runtime\src\device_session_host.cpp" />
    <ClCompile Include="$(RIVET_ROOT)\runtime\src\discovery_advertisement.cpp" />
    <ClCompile Include="$(RIVET_ROOT)\runtime\src\protocol.cpp" />
    <ClCompile Include="$(RIVET_ROOT)\runtime\src\sha256.cpp" />
    <ClCompile Include="$(RIVET_ROOT)\runtime\src\utf8.cpp" />
    <ClCompile Include="$(RIVET_ROOT)\runtime\src\x509_spki.cpp" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
