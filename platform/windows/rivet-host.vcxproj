<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Rivet Windows host platform library (issue #238).

       Downstream hosts never <ClCompile> Rivet sources into their own
       projects. They reference this project instead:

         <ItemGroup>
           <ProjectReference
             Include="$(RIVET_ROOT)\platform\windows\rivet-host.vcxproj"
             Properties="RivetRuntimeLibrary=MultiThreadedDebug" />
         </ItemGroup>

       The Properties= facet forwards the downstream CRT choice (MSVC
       rejects mixed RuntimeLibrary across a static link, LNK2038);
       MultiThreadedDebug / MultiThreaded for /MT-style hosts
       (hybrid-CRT WinUI hosts), MultiThreadedDebugDLL /
       MultiThreadedDLL otherwise.

       RIVET_ROOT and RIVET_RACKET_INCLUDE arrive as environment
       variables from `raco rivet build` (or manual exports). -->
  <PropertyGroup Label="NuGet">
    <RestoreProjectStyle>PackageReference</RestoreProjectStyle>
    <NuGetTargetMoniker>native,Version=v0.0</NuGetTargetMoniker>
    <NuGetTargetPlatformIdentifier>Windows</NuGetTargetPlatformIdentifier>
    <NuGetTargetPlatformVersion>$(WindowsTargetPlatformVersion)</NuGetTargetPlatformVersion>
    <!-- Both released libraries live in this directory. NuGet otherwise
         gives them the same obj/project.assets.json and silently drops one
         project from the restore graph. -->
    <MSBuildProjectExtensionsPath>$(MSBuildThisFileDirectory)obj\rivet-host\</MSBuildProjectExtensionsPath>
  </PropertyGroup>
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|ARM64">
      <Configuration>Debug</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|ARM64">
      <Configuration>Release</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>17.0</VCProjectVersion>
    <ProjectGuid>{DC7F7B91-5DEF-4F64-8FDC-06562C2AC64B}</ProjectGuid>
    <Keyword>Win32Proj</Keyword>
    <RootNamespace>rivet</RootNamespace>
    <ProjectName>rivet-host</ProjectName>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <RivetWinAppSDKVersion Condition="'$(RivetWinAppSDKVersion)' == ''">2.4.0</RivetWinAppSDKVersion>
    <RivetCppWinRTVersion Condition="'$(RivetCppWinRTVersion)' == ''">3.0.260818.1</RivetCppWinRTVersion>
    <ConfigurationType>StaticLibrary</ConfigurationType>
    <PlatformToolset>v145</PlatformToolset>
    <PlatformToolset Condition="'$(VisualStudioVersion)' == '17.0'">v143</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
    <UseDebugLibraries Condition="'$(Configuration)'=='Debug'">true</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(Configuration)'=='Release'">false</UseDebugLibraries>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'" Label="Configuration">
    <WholeProgramOptimization>false</WholeProgramOptimization>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <ConformanceMode>true</ConformanceMode>
      <!-- Sources and headers are UTF-8; without this MSVC reads them in
           the system code page and CJK-locale machines drown in C4819
           (and misread any non-ASCII literal). Downstream hosts already
           build with /utf-8 — the linked static library must match. -->
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <WarningLevel>Level4</WarningLevel>
      <SDLCheck>true</SDLCheck>
      <AdditionalIncludeDirectories>$(RIVET_RACKET_INCLUDE);$(RIVET_ROOT)\runtime\include;$(RIVET_ROOT)\platform\windows\runtime;$(RIVET_ROOT)\platform\windows\system;$(RIVET_ROOT)\platform\windows\update;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <RuntimeLibrary Condition="'$(RivetRuntimeLibrary)' != ''">$(RivetRuntimeLibrary)</RuntimeLibrary>
      <PreprocessorDefinitions>WIN32;_WINDOWS;NOMINMAX;_SILENCE_EXPERIMENTAL_COROUTINE_DEPRECATION_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemGroup>
    <!-- The library consumes the App SDK itself so its C++/WinRT headers
         come from the same NuGet graph as the downstream exe; mixed
         cppwinrt versions are an LNK2038 at link time. -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="$(RivetWinAppSDKVersion)" />
    <PackageReference Include="Microsoft.Windows.CppWinRT" Version="$(RivetCppWinRTVersion)" />
  </ItemGroup>
  <!-- The authoritative ClCompile set lives in rivet-runtime-sources.props
       (issue #280): this build and every vendored-source host must consume
       the same list, so a new translation unit cannot ship without reaching
       downstream Windows hosts. -->
  <Import Project="$(MSBuildThisFileDirectory)rivet-runtime-sources.props" />
  <ItemGroup>
    <ClInclude Include="$(RIVET_ROOT)\platform\windows\device\device_identity.hpp" />
    <ClInclude Include="$(RIVET_ROOT)\platform\windows\device\device_listener.hpp" />
    <ClInclude Include="$(RIVET_ROOT)\platform\windows\device\device_session_service.hpp" />
    <ClInclude Include="$(RIVET_ROOT)\platform\windows\device\schannel_transport.hpp" />
    <ClInclude Include="$(RIVET_ROOT)\platform\windows\runtime\backend.hpp" />
    <ClInclude Include="$(RIVET_ROOT)\platform\windows\runtime\win32_pipe_transport.hpp" />
    <ClInclude Include="$(RIVET_ROOT)\platform\windows\system\system_services.hpp" />
    <ClInclude Include="$(RIVET_ROOT)\platform\windows\update\update_handoff.hpp" />
    <ClInclude Include="$(RIVET_ROOT)\runtime\include\rivet\protocol.hpp" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
