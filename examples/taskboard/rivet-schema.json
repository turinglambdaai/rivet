      "fields": [
        {
          "name": "id",
          "type": {
            "kind": "scalar",
            "name": "Int64"
          }
        },
        {
          "name": "title",
          "type": {
            "kind": "scalar",
            "name": "String"
          }
        },
        {
          "name": "notes",
          "type": {
            "kind": "scalar",
            "name": "String"
          }
        },
        {
          "name": "status",
          "type": {
            "kind": "record",
            "name": "TaskStatus"
          }
        }
      ],
      "name": "BoardTask"
