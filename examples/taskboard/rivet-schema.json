    {
      "arguments": [],
      "name": "list-tasks",
      "result": {
        "element": {
          "kind": "record",
          "name": "BoardTask"
        },
        "kind": "list"
      }
    },
    {
      "arguments": [],
      "name": "reload-sample-tasks",
      "result": {
        "element": {
          "kind": "record",
          "name": "BoardTask"
        },
        "kind": "list"
      }
    },
    {
      "arguments": [
        {
          "name": "id",
          "type": {
            "kind": "scalar",
            "name": "Int64"
          }
        }
      ],
      "name": "select-task",
      "result": {
        "element": {
          "kind": "record",
          "name": "BoardTask"
        },
